VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
GEMINI_API_KEY=your-server-only-gemini-key
# Optional: use the local FastAPI + Chroma RAG service during development.
VITE_RAG_API_URL=http://localhost:8000
# Only needed when RAG_API_SECRET is enabled in rag-api/.env
VITE_RAG_API_SECRET=
USE_FAISS=false
VITE_WHATSAPP_ENGINE_URL=http://localhost:3001
# Comma-separated Supabase account emails allowed to manage WhatsApp.
VITE_ADMIN_EMAILS=admin@example.com
