# Wasil WhatsApp Engine - Environment Variables

# Supabase
SUPABASE_URL=your_supabase_url
SUPABASE_SERVICE_KEY=your_service_role_key

# Redis (Upstash)
REDIS_URL=redis://localhost:6379

# Web App URL (for CORS)
WEB_URL=http://localhost:3000

# Server Port
PORT=3001
STOMACARE_AUTO_REPLY=true
STOMACARE_RAG_URL=http://127.0.0.1:8000
STOMACARE_RAG_SECRET=
